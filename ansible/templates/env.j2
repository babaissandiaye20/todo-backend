# Modele du .env genere par Ansible SUR la VM (jamais commit avec de vraies valeurs).
# Les valeurs sont lues depuis l'environnement du lanceur (local: source .env / CI: GitHub Secrets).
PORT={{ lookup('env', 'PORT') | default('4000', true) }}
NODE_ENV=production

# Image a tirer depuis Docker Hub (ex: moncompte/todo_backend:latest)
BACKEND_IMAGE={{ lookup('env', 'BACKEND_IMAGE') }}

# Secrets MySQL
MYSQL_DATABASE={{ lookup('env', 'MYSQL_DATABASE') }}
MYSQL_USER={{ lookup('env', 'MYSQL_USER') }}
MYSQL_PASSWORD={{ lookup('env', 'MYSQL_PASSWORD') }}
MYSQL_ROOT_PASSWORD={{ lookup('env', 'MYSQL_ROOT_PASSWORD') }}
